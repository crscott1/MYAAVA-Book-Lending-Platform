<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE generatorConfiguration
        PUBLIC "-//mybatis.org//DTD MyBatis Generator Configuration 1.0//EN"
        "http://mybatis.org/dtd/mybatis-generator-config_1_0.dtd">

<generatorConfiguration>
    <context id="DB" targetRuntime="MyBatis3">
        <commentGenerator>
            <property name="suppressAllComments" value="true"/>
        </commentGenerator>

        <jdbcConnection driverClass="com.mysql.cj.jdbc.Driver"
                        connectionURL="jdbc:mysql://localhost:3306/book-lending-system"
                        userId="root"
                        password="1108"/>

        <javaModelGenerator targetPackage="edu.arizona.csc536.book_lending_system.domain" targetProject="src/main/java"/>
        <sqlMapGenerator targetPackage="mapper" targetProject="src/main/resources"/>
        <javaClientGenerator type="XMLMAPPER" targetPackage="edu.arizona.csc536.book_lending_system.mapper" targetProject="src/main/java"/>

        <!-- 列出你所有的表 -->
        <table tableName="admin" domainObjectName="Admin"/>
        <table tableName="book" domainObjectName="Book"/>
        <table tableName="book_category" domainObjectName="BookCategory"/>
        <table tableName="borrowingbooks" domainObjectName="BorrowingBooks"/>
        <table tableName="user" domainObjectName="User"/>
    </context>
</generatorConfiguration>
